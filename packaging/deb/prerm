#!/bin/sh
# prerm для wb-mqtt-noolite: останавливает службу перед удалением/обновлением пакета.
set -e

case "$1" in
    remove|deconfigure|upgrade)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop wb-mqtt-noolite >/dev/null 2>&1 || true
        fi
        ;;
    *)
        ;;
esac

exit 0
